#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HRMR: HRMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 12 24 25 1 2 3 4 5 14 15 16 17 26 27 28 29 36 37 38 13 39 40 41>;
            require-prior-idle-ms = <150>;
        };

        HRML: HRML {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41 39 37 36 38>;
            require-prior-idle-ms = <150>;
        };

        smart_period: smart_period {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_PERIOD";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        smart_comma: smart_comma {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_COMMA";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        spaceSuper: spaceSuper {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACESUPER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-unless-interrupted";
        };

        stickyMod: stickyMod {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKYMOD";
            bindings = <&sk>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        shiftcaps: shiftcaps {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFTCAPS";
            #binding-cells = <0>;
            bindings = <&stickyMod LEFT_SHIFT>, <&kp CAPS>;

            tapping-term-ms = <200>;
        };

        StickyNumbers: StickyNumbers {
            compatible = "zmk,behavior-tap-dance";
            label = "STICKYNUMBERS";
            #binding-cells = <0>;
            bindings = <&sl 3>, <&tog 3>;

            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        boot_left {
            bindings = <&bootloader>;
            key-positions = <1 2 0>;
            timeout-ms = <20>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <10 10 11>;
            layers = <0>;
        };

        s {
            bindings = <&tog 5>;
            key-positions = <16 15 19 20>;
            layers = <0 5>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&macro_tap>;

            label = "NEW_MACRO";
            tap-ms = <10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp Q  &kp W  &kp F  &kp P  &kp B                &none    &none  &kp J      &kp L  &kp U         &kp Y          &kp BSPC
&kp A  &kp R  &kp S  &kp T  &kp G                &none    &none  &kp M      &kp N  &kp E         &kp I          &kp O
&kp Z  &kp X  &kp C  &kp D  &kp V                &none    &none  &kp K      &kp H  &smart_comma  &smart_period  &kp RET
                     &none  &spaceSuper 1 SPACE  &none    &none  &kp SPACE  &none
            >;
        };

        left {
            bindings = <
&kp ESCAPE  &none                &none                    &none       &none                &none    &none  &none  &none           &none  &none  &kp BACKSPACE
&kp TAB     &stickyMod LEFT_ALT  &stickyMod LEFT_CONTROL  &shiftcaps  &stickyMod LEFT_GUI  &none    &none  &none  &StickyNumbers  &none  &none  &none
&none       &none                &none                    &none       &none                &none    &none  &none  &none           &none  &none  &kp ENTER
                                                          &none       &none                &none    &none  &none  &none
            >;
        };

        right {
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;
        };

        number {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none    &none  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&none   &none   &none   &none   &none   &none    &none  &kp N0  &kp N4  &kp N5  &kp N6  &none
&none   &none   &none   &none   &none   &none    &none  &none   &kp N1  &kp N2  &kp N3  &none
                        &none   &none   &none    &none  &none   &none
            >;
        };

        symbols {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        wasd {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3        &kp N4                &none    &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &none
&kp TAB    &kp Q   &kp W   &kp E         &kp R                 &none    &kp T   &kp Y   &kp U   &kp I   &kp O   &none
&kp LCTRL  &kp A   &kp S   &kp D         &kp F                 &none    &kp G   &kp H   &kp J   &kp K   &kp L   &none
                           &kp LEFT_ALT  &mt LEFT_SHIFT SPACE  &none    &none   &none   &none
            >;
        };
    };
};
