#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HRMR: HRMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 12 24 25 1 2 3 4 5 14 15 16 17 26 27 28 29 36 37 38 13 39 40 41>;
            require-prior-idle-ms = <150>;
        };

        HRML: HRML {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41 39 37 36 38>;
            require-prior-idle-ms = <150>;
        };

        smart_period: smart_period {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_PERIOD";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        smart_comma: smart_comma {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_COMMA";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_mark: smart_mark {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_MARK";
            bindings = <&kp EXCL>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_paren: smart_paren {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_PAREN";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_then: smart_then {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_THEN";
            bindings = <&kp LESS_THAN>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_plus_minus: smart_plus_minus {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_PLUS_MINUS";
            bindings = <&kp PLUS>, <&kp MINUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_multi_div: smart_multi_div {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_MULTI_DIV";
            bindings = <&kp ASTERISK>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_under: smart_under {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_UNDER";
            bindings = <&kp UNDERSCORE>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        smart_thenxx: smart_thenxx {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_THENXX";
            bindings = <&kp>, <&smart_then>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41 7 8 9 19 20 21 36 37 38 39>;
        };

        smart_bracket: smart_bracket {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_BRACKET";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_bracketxx: smart_bracketxx {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_BRACKETXX";
            bindings = <&kp>, <&smart_bracket>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41 39 36 37 38>;
        };

        smart_parenxx: smart_parenxx {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_PARENXX";
            bindings = <&kp>, <&smart_paren>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 37 38 36 37>;
        };

        smart_brace: smart_brace {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_BRACE";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        smart_bracexx: smart_bracexx {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_BRACEXX";
            bindings = <&kp>, <&smart_brace>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41 7 8 9 10 19 20 21 36 37 38>;
        };

        smart_equal: smart_equal {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_EQUAL";
            bindings = <&kp KP_EQUAL>, <&kp HASH>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        smart_remain: smart_remain {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_REMAIN";
            bindings = <&kp PERCENT>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        smart_at: smart_at {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_AT";
            bindings = <&kp AT_SIGN>, <&kp DOLLAR>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        smart_tilde: smart_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_TILDE";
            bindings = <&kp TILDE>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        smart_markxx: smart_markxx {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_MARKXX";
            bindings = <&kp>, <&smart_mark>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 12 24 25 1 2 3 4 5 14 15 16 17 26 27 28 29 36 37 38 13 39 40 41>;
            require-prior-idle-ms = <150>;
        };

        smart_tildexx: smart_tildexx {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_TILDEXX";
            bindings = <&kp>, <&smart_tilde>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 12 24 25 1 2 3 4 5 14 15 16 17 26 27 28 29 36 37 38 13 39 40 41>;
            require-prior-idle-ms = <150>;
        };

        smart_atxx: smart_atxx {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_ATXX";
            bindings = <&kp>, <&smart_at>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 12 24 25 1 2 3 4 5 14 15 16 17 26 27 28 29 36 37 38 13 39 40 41>;
            require-prior-idle-ms = <150>;
        };

        smart_and: smart_and {
            compatible = "zmk,behavior-mod-morph";
            label = "SMART_AND";
            bindings = <&kp AMPERSAND>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        TDspace: TDspace {
            compatible = "zmk,behavior-tap-dance";
            label = "TDSPACE";
            #binding-cells = <0>;
            bindings = <&spaceSuper 0 SPACE>, <&kp TAB>;
        };

        spaceSuper: spaceSuper {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACESUPER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        superMod: superMod {
            compatible = "zmk,behavior-sticky-key";
            label = "SUPERMOD";
            bindings = <&sk>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        superquote: superquote {
            compatible = "zmk,behavior-mod-morph";
            label = "SUPERQUOTE";
            bindings = <&kp DOUBLE_QUOTES>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        superquoteFinal: superquoteFinal {
            compatible = "zmk,behavior-mod-morph";
            label = "SUPERQUOTEFINAL";
            bindings = <&superquote>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        TDshift: TDshift {
            compatible = "zmk,behavior-tap-dance";
            label = "TDSHIFT";
            #binding-cells = <0>;
            bindings = <&superMod LEFT_SHIFT>, <&kp CAPS>;

            tapping-term-ms = <200>;
        };

        wasd_space: _wasd_space {
            compatible = "zmk,behavior-hold-tap";
            label = " WASD_SPACE";
            bindings = <&kp>, <&new_macro>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            hold-while-undecided;
        };
    };

    combos {
        compatible = "zmk,combos";

        boot_left {
            bindings = <&bootloader>;
            key-positions = <1 2 0>;
            timeout-ms = <20>;
            require-prior-idle-ms = <150>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <11 10>;
        };

        s {
            bindings = <&tog 0>;
            key-positions = <16 15 19 20>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&macro_tap>;

            label = "NEW_MACRO";
            tap-ms = <10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q  &kp W  &kp F  &kp P   &kp B   &kp B     &trans  &kp J   &kp L   &kp U      &kp L    &kp Y
&kp A  &kp R  &kp S  &kp T   &kp G   &trans    &trans  &kp M   &kp N   &kp E      &kp I    &kp O
&kp Z  &kp X  &kp C  &kp D   &kp V   &trans    &trans  &kp K   &kp H   &kp COMMA  &kp DOT  &kp RET
                     &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
